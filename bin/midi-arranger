#!/usr/bin/env bash
set -euo pipefail

readonly EX_USAGE=64
readonly EX_NOINPUT=66
readonly EX_UNAVAILABLE=69
readonly BRIEF_HASH_FILE_NAME="brief.sha256"
readonly COMPLETION_SENTINEL="<promise>COMPLETE</promise>"
readonly PROMPT_OVERRIDE_ENV_NAME="MIDI_ARRANGER_PROMPT_FILE"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
INSTALL_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
readonly SCRIPT_DIR
readonly INSTALL_ROOT
readonly PROMPTS_DIR="$INSTALL_ROOT/prompts"

SUPPORTED_TOOLS="claude codex agy cursor opencode amp gemini"
EFFORT_EXPLICIT=0

print_usage() {
  cat <<'EOF'
Usage:
  midi-arranger brief [options] <input.mid>
  midi-arranger run [options] [max_iterations]
  midi-arranger tool [options] <tool-name> [tool-args...]
  midi-arranger doctor [options]
  midi-arranger test-drive [options]
  midi-arranger --list-models [options]
  midi-arranger --help

Subcommands:
  brief          Interview the user and write arrangement-brief.json.
  run            Run the autonomous arrangement loop.
  tool           Invoke the deterministic MIDI tool layer.
  doctor         Diagnose the local environment (Python, deps, provider, tools).
  test-drive     Run the analyze/plan/render/validate flow on a mocked profile.
  --list-models  Show models and effort levels announced by installed AI CLIs.
  --help         Show this help message.

Common options:
  --tool TOOL     AI CLI to use: claude, codex, agy, cursor, opencode, amp, gemini.
  --tool=TOOL     Same as above.
  --model MODEL   Model to pass through to the chosen AI CLI.
  --model=MODEL   Same as above.
  --effort LEVEL  Reasoning effort to pass through when the chosen AI CLI supports it.
  --effort=LEVEL  Same as above.
  --cwd DIR       Project root to use instead of auto-detecting from the current directory.
  --cwd=DIR       Same as above.
  -h, --help      Show this help message.

test-drive options:
  --fixture PATH  MIDI to test-drive with (default: the bundled corpus fixture).
  --fixture=PATH  Same as above.
  --keep          Preserve the isolated workspace instead of deleting it.

Examples:
  midi-arranger brief song.mid
  midi-arranger run --tool codex --effort high 12
  midi-arranger --cwd /path/to/project --list-models
  midi-arranger tool analyze song.mid
  midi-arranger doctor --tool claude
  midi-arranger test-drive --keep

Run iterations:
  max_iterations defaults to 10. As a rule of thumb, use one iteration per
  instrument family to arrange, plus extra room for validation fixes.

doctor and test-drive exit codes:
  0  healthy / flow completed with no musical validation error
  1  test-drive ran but a validator reported a musical error
  2  environment problem (missing dependency, provider not found, etc.)
EOF
}

die_usage() {
  printf 'Error: %s\n' "$1" >&2
  exit "$EX_USAGE"
}

die_unavailable() {
  printf 'Error: %s\n' "$1" >&2
  exit "$EX_UNAVAILABLE"
}

die_noinput() {
  printf 'Error: %s\n' "$1" >&2
  exit "$EX_NOINPUT"
}

die_missing_binary() {
  printf 'Error: %s was not found in PATH. Install the %s CLI and try again.\n' "$1" "$2" >&2
  exit "$EX_UNAVAILABLE"
}

validate_tool() {
  case " $SUPPORTED_TOOLS " in
    *" $1 "*) ;;
    *) die_usage "Invalid tool '$1'. Must be one of: $SUPPORTED_TOOLS." ;;
  esac
}

resolve_opencode_bin() {
  if command -v opencode >/dev/null 2>&1; then
    command -v opencode
    return 0
  fi

  if [[ -x "$HOME/.opencode/bin/opencode" ]]; then
    printf '%s\n' "$HOME/.opencode/bin/opencode"
    return 0
  fi

  return 1
}

tool_binary_path() {
  case "$1" in
    cursor)
      command -v cursor-agent 2>/dev/null
      ;;
    opencode)
      resolve_opencode_bin
      ;;
    *)
      command -v "$1" 2>/dev/null
      ;;
  esac
}

tool_display_binary() {
  case "$1" in
    cursor) printf '%s\n' "cursor-agent" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

require_tool_installed() {
  local tool="$1"
  local display

  if ! tool_binary_path "$tool" >/dev/null 2>&1; then
    display="$(tool_display_binary "$tool")"
    die_missing_binary "$display" "$display"
  fi
}

require_python3() {
  if ! command -v python3 >/dev/null 2>&1; then
    die_unavailable "python3 not found in PATH; '$1' requires Python >= 3.11 to run."
  fi
}

run_python_module() {
  # `doctor`/`test-drive` sao Python puro (US-078): sem LLM, sem rede,
  # deterministico. `bin/` so resolve o provider (aqui) e delega a
  # introspeccao/execucao real a `tools/`, para nunca duplicar aquela logica
  # em bash. `exec` troca o processo bash pelo python, entao o codigo de
  # saida do modulo (0/1/2, documentado em `tools/doctor.py` e
  # `tools/test_drive.py`) vira o codigo de saida do comando inteiro, sem
  # passar pelos codigos sysexits do resto deste script.
  local module="$1"
  shift
  PYTHONPATH="$INSTALL_ROOT${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m "$module" "$@"
}

validate_effort_support() {
  local tool="$1"

  if [[ "$EFFORT_EXPLICIT" -ne 1 ]]; then
    return 0
  fi

  case "$tool" in
    claude|codex|agy|cursor|opencode)
      ;;
    amp|gemini)
      die_usage "--effort is not supported by '$tool'."
      ;;
  esac

  if [[ "$tool" == "cursor" && -z "$MODEL" ]]; then
    die_usage "cursor carries effort inside --model, so --effort requires --model."
  fi
}

cursor_model_argument() {
  local model="$1"
  local effort="$2"

  if [[ -z "$effort" ]]; then
    printf '%s\n' "$model"
    return 0
  fi

  if [[ "$model" == *"["*"]" ]]; then
    printf '%s\n' "$model"
    return 0
  fi

  printf '%s[effort=%s]\n' "$model" "$effort"
}

capture_agent_output() {
  local output_file="$1"
  shift

  mkdir -p "$(dirname "$output_file")"
  : > "$output_file"

  set +e
  "$@" 2>&1 | tee "$output_file"
  local command_status=${PIPESTATUS[0]}
  set -e

  return "$command_status"
}

run_cli_query() {
  local binary="$1"
  shift

  set +e
  "$binary" "$@" </dev/null 2>&1
  set -e
  return 0
}

normalize_discovery_words() {
  tr "',()[]{}" ' ' \
    | tr ',|' '  ' \
    | awk '
        {
          for (field_index = 1; field_index <= NF; field_index += 1) {
            value = $field_index
            gsub(/^[[:space:]-]+|[[:space:].;:]+$/, "", value)
            if (value != "" && !seen[value]++) {
              print value
            }
          }
        }
      ' \
    | tr '\n' ' ' \
    | sed 's/[[:space:]]*$//'
}

extract_configured_model() {
  awk '
    {
      line = $0
      lower = tolower(line)
    }
    lower ~ /(configured default|configured model|current model|default model)/ && line ~ /[:=]/ {
      sub(/^[^:=]*[:=][[:space:]]*/, "", line)
      gsub(/[`"'\''<>]/, "", line)
      split(line, parts)
      print parts[1]
      exit
    }
  '
}

extract_advertised_models() {
  awk '
    {
      line = $0
      lower = tolower(line)
    }
    lower ~ /(error|unknown command|not found|usage:|options:|authentication|login|api-key)/ {
      next
    }
    lower ~ /(available models|advertised models|models:|model aliases|model ids)/ {
      sub(/^[^:]*:[[:space:]]*/, "", line)
      print line
      next
    }
    line ~ /^[[:space:]]*[-*]?[[:space:]]*[[:alnum:]][[:alnum:]._:\/-]+[[:space:]]*$/ {
      gsub(/^[[:space:]]*[-*][[:space:]]*/, "", line)
      print line
    }
  ' | normalize_discovery_words
}

extract_effort_values() {
  awk '
    {
      lower = tolower($0)
    }
    lower ~ /effort|variant/ {
      print
    }
  ' \
    | tr "',()[]{}" ' ' \
    | tr ',|' '  ' \
    | awk '
        {
          for (field_index = 1; field_index <= NF; field_index += 1) {
            value = tolower($field_index)
            gsub(/^[[:space:]-]+|[[:space:].;:]+$/, "", value)
            if (value ~ /^(minimal|low|medium|high|xhigh|max)$/ && !seen[value]++) {
              print value
            }
          }
        }
      ' \
    | tr '\n' ' ' \
    | sed 's/[[:space:]]*$//'
}

codex_configured_model() {
  # A CLI do codex nao anuncia lista de modelos nem o default. O que existe e a
  # chave `model` em ~/.codex/config.toml. Emitido no formato que
  # `extract_configured_model` reconhece.
  local cfg="${CODEX_HOME:-$HOME/.codex}/config.toml"
  [[ -f "$cfg" ]] || return 0
  local model
  model="$(sed -n 's/^[[:space:]]*model[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$cfg" 2>/dev/null | head -n 1)"
  [[ -n "$model" ]] && printf 'configured model: %s\n' "$model"
}

tool_model_query_output() {
  local tool="$1"
  local binary="$2"

  case "$tool" in
    claude)
      run_cli_query "$binary" --help
      ;;
    codex)
      # `codex models` nao e subcomando: a CLI trata o argumento como lixo e cai
      # no help interativo. O default do usuario vive em ~/.codex/config.toml, que
      # e a mesma fonte que o ralph consulta.
      codex_configured_model
      ;;
    agy)
      run_cli_query "$binary" models
      ;;
    cursor)
      run_cli_query "$binary" --list-models
      ;;
    opencode)
      run_cli_query "$binary" models
      ;;
    amp)
      run_cli_query "$binary" --help
      ;;
    gemini)
      run_cli_query "$binary" --help
      ;;
  esac
}

tool_help_query_output() {
  local tool="$1"
  local binary="$2"

  run_cli_query "$binary" --help
  case "$tool" in
    codex)
      run_cli_query "$binary" exec --help
      ;;
    opencode)
      run_cli_query "$binary" run --help
      ;;
  esac
}

tool_has_effort_adapter() {
  case "$1" in
    claude|codex|agy|cursor|opencode)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

print_model_discovery() {
  local tool
  local binary
  local model_output
  local help_output
  local combined_output
  local configured
  local advertised
  local efforts

  echo "Models"
  echo ""

  for tool in $SUPPORTED_TOOLS; do
    if ! binary="$(tool_binary_path "$tool")"; then
      printf '  %-8s (%s)\n' "$tool" "absent"
      printf '    configured default : not queried\n'
      printf '    advertised by CLI  : not queried\n'
      printf '    effort             : not queried\n'
      echo ""
      continue
    fi

    model_output="$(tool_model_query_output "$tool" "$binary")"
    help_output="$(tool_help_query_output "$tool" "$binary")"
    combined_output="$model_output
$help_output"
    configured="$(printf '%s\n' "$combined_output" | extract_configured_model)"
    advertised="$(printf '%s\n' "$model_output" | extract_advertised_models)"
    efforts="$(printf '%s\n' "$help_output" | extract_effort_values)"

    printf '  %-8s (%s)\n' "$tool" "installed"

    if [[ -n "$configured" ]]; then
      printf '    configured default : %s\n' "$configured"
    else
      printf '    configured default : not announced by CLI\n'
    fi

    if [[ -n "$advertised" ]]; then
      printf '    advertised by CLI  : %s\n' "$advertised"
    else
      printf '    advertised by CLI  : no model list announced by CLI\n'
    fi

    if ! tool_has_effort_adapter "$tool"; then
      printf '    effort             : not supported by this CLI\n'
    elif [[ -n "$efforts" ]]; then
      printf '    effort             : %s\n' "$efforts"
    else
      printf '    effort             : not announced by CLI\n'
    fi

    echo ""
  done
}

build_agent_prompt() {
  local mode="$1"
  local detail="$2"

  printf 'midi-arranger %s\nproject_root=%s\n%s\n' "$mode" "$PROJECT_ROOT" "$detail"
  if [[ "$mode" == "run" ]]; then
    append_run_prompt_driver
  fi
}

tool_prompt_driver_name() {
  case "$1" in
    claude) printf '%s\n' "CLAUDE.md" ;;
    codex) printf '%s\n' "CODEX.md" ;;
    agy) printf '%s\n' "AGY.md" ;;
    cursor) printf '%s\n' "CURSOR.md" ;;
    opencode) printf '%s\n' "OPENCODE.md" ;;
    amp) printf '%s\n' "AMP.md" ;;
    gemini) printf '%s\n' "GEMINI.md" ;;
    *) die_usage "Invalid tool '$1'. Must be one of: $SUPPORTED_TOOLS." ;;
  esac
}

canonical_file_path() {
  local path="$1"
  local dir
  local base

  dir="$(dirname "$path")"
  base="$(basename "$path")"
  dir="$(cd "$dir" && pwd -P)" || return 1
  printf '%s/%s\n' "$dir" "$base"
}

resolve_run_prompt_driver() {
  local override="${MIDI_ARRANGER_PROMPT_FILE:-}"
  local driver

  if [[ -n "$override" ]]; then
    if [[ ! -f "$override" ]]; then
      die_noinput "$PROMPT_OVERRIDE_ENV_NAME points to a prompt driver that does not exist: $override"
    fi
    canonical_file_path "$override" \
      || die_noinput "$PROMPT_OVERRIDE_ENV_NAME points to a prompt driver that cannot be resolved: $override"
    return 0
  fi

  driver="$PROMPTS_DIR/$(tool_prompt_driver_name "$TOOL")"
  if [[ ! -f "$driver" ]]; then
    die_noinput "Prompt driver for tool '$TOOL' not found: $driver"
  fi

  printf '%s\n' "$driver"
}

append_run_prompt_driver() {
  local driver

  driver="$(resolve_run_prompt_driver)"
  if [[ ! -r "$driver" ]]; then
    die_noinput "Prompt driver is not readable: $driver"
  fi

  printf 'prompt_driver_file=%s\nprompt_driver_begin\n' "$driver"
  cat "$driver" || die_noinput "Could not read prompt driver: $driver"
  printf '\nprompt_driver_end\n'
}

run_prompt_detail() {
  printf 'iteration=%s\nmax_iterations=%s\narrangement_brief=%s\narrangement_plan=%s\nprogress_file=%s\nstate_dir=%s\nbrief_readonly=true\nbrief_readonly_rule=%s\n' \
    "$CURRENT_ITERATION" "$MAX_ITERATIONS" "$BRIEF_FILE" "$PLAN_FILE" "$PROGRESS_FILE" "$STATE_DIR" \
    "Do not edit arrangement-brief.json during run; if requirements change, stop and report that a new brief is required."
}

assert_brief_unchanged_during_run() {
  local current_hash

  if [[ ! -f "$BRIEF_FILE" ]]; then
    {
      printf '\nError: arrangement-brief.json was removed during run: %s\n' "$BRIEF_FILE"
      printf 'A changed requirement requires a new brief. Run midi-arranger brief <input.mid> before retrying.\n'
    } >&2
    return 1
  fi

  current_hash="$(sha256_file "$BRIEF_FILE")" \
    || die_unavailable "could not hash arrangement brief: $BRIEF_FILE"

  if [[ "$current_hash" != "$RUN_BRIEF_HASH" ]]; then
    {
      printf '\nError: arrangement-brief.json changed during run: %s\n' "$BRIEF_FILE"
      printf 'The brief is read-only while run is active; a changed requirement requires a new brief.\n'
      printf 'Run midi-arranger brief <input.mid> before retrying.\n'
    } >&2
    return 1
  fi
}

run_agent_loop() {
  local iteration

  for ((iteration = 1; iteration <= MAX_ITERATIONS; iteration += 1)); do
    CURRENT_ITERATION="$iteration"
    printf '\n== midi-arranger run iteration %s/%s ==\n' "$iteration" "$MAX_ITERATIONS"
    invoke_agent_once "run" "$(run_prompt_detail)"
    assert_brief_unchanged_during_run

    if grep -qF "$COMPLETION_SENTINEL" "$AGENT_OUTPUT_FILE"; then
      printf '\nmidi-arranger run completed at iteration %s/%s.\n' "$iteration" "$MAX_ITERATIONS"
      return 0
    fi
  done

  {
    printf '\nError: midi-arranger run reached max_iterations=%s without completion sentinel %s.\n' \
      "$MAX_ITERATIONS" "$COMPLETION_SENTINEL"
    printf 'Check progress log for current status: %s\n' "$PROGRESS_FILE"
  } >&2
  return 1
}

invoke_agent_once() {
  local mode="$1"
  local detail="$2"
  local prompt
  local binary

  validate_effort_support "$TOOL"
  require_tool_installed "$TOOL"
  prompt="$(build_agent_prompt "$mode" "$detail")"
  binary="$(tool_binary_path "$TOOL")"

  # O agente trabalha sobre o projeto, e o prompt anuncia `project_root`. Sem
  # este `cd`, uma invocacao a partir de subdiretorio (ou com `--cwd`) roda o
  # agente no diretorio errado e ele le e escreve os arquivos errados. Apenas
  # `codex` recebe a raiz por flag (`-C`); os demais herdam o cwd do processo.
  cd "$PROJECT_ROOT" || die_unavailable "could not enter project root: $PROJECT_ROOT"

  case "$TOOL" in
    claude)
      local claude_args=(--print --dangerously-skip-permissions)
      [[ -n "$MODEL" ]] && claude_args+=(--model "$MODEL")
      [[ "$EFFORT_EXPLICIT" -eq 1 ]] && claude_args+=(--effort "$EFFORT")
      printf '%s\n' "$prompt" | capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${claude_args[@]}"
      ;;
    codex)
      local codex_args=(exec --dangerously-bypass-approvals-and-sandbox -C "$PROJECT_ROOT")
      [[ -n "$MODEL" ]] && codex_args+=(--model "$MODEL")
      [[ "$EFFORT_EXPLICIT" -eq 1 ]] && codex_args+=(-c "model_reasoning_effort=\"$EFFORT\"")
      printf '%s\n' "$prompt" | capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${codex_args[@]}" -
      ;;
    agy)
      local agy_args=(--print --dangerously-skip-permissions)
      [[ -n "$MODEL" ]] && agy_args+=(--model "$MODEL")
      [[ "$EFFORT_EXPLICIT" -eq 1 ]] && agy_args+=(--effort "$EFFORT")
      printf '%s\n' "$prompt" | capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${agy_args[@]}"
      ;;
    cursor)
      local cursor_args=(--print --force)
      local cursor_model="$MODEL"
      if [[ "$EFFORT_EXPLICIT" -eq 1 ]]; then
        cursor_model="$(cursor_model_argument "$MODEL" "$EFFORT")"
      fi
      [[ -n "$cursor_model" ]] && cursor_args+=(--model "$cursor_model")
      capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${cursor_args[@]}" "$prompt"
      ;;
    opencode)
      local opencode_args=(run --auto)
      [[ -n "$MODEL" ]] && opencode_args+=(--model "$MODEL")
      [[ "$EFFORT_EXPLICIT" -eq 1 ]] && opencode_args+=(--variant "$EFFORT")
      capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${opencode_args[@]}" "$prompt"
      ;;
    amp)
      local amp_args=(--dangerously-allow-all)
      [[ -n "$MODEL" ]] && amp_args+=(--model "$MODEL")
      printf '%s\n' "$prompt" | capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${amp_args[@]}"
      ;;
    gemini)
      local gemini_args=(--approval-mode yolo)
      [[ -n "$MODEL" ]] && gemini_args+=(--model "$MODEL")
      capture_agent_output "$AGENT_OUTPUT_FILE" "$binary" "${gemini_args[@]}" --prompt "$prompt"
      ;;
  esac
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [[ -z "$value" || "$value" == --* ]]; then
    die_usage "$option requires a value."
  fi
}

resolve_project_root() {
  local start_dir="$1"
  local dir

  dir="$(cd "$start_dir" && pwd -P)" || die_usage "Cannot access directory '$start_dir'."

  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.git" || -f "$dir/.git" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi

    if [[ -f "$dir/arrangement-brief.json" \
      || -f "$dir/arrangement-plan.json" \
      || -f "$dir/progress.txt" \
      || -d "$dir/.midiarranger" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi

    dir="$(dirname "$dir")"
  done

  pwd -P
}

initialize_project_paths() {
  BRIEF_FILE="$PROJECT_ROOT/arrangement-brief.json"
  PLAN_FILE="$PROJECT_ROOT/arrangement-plan.json"
  PROGRESS_FILE="$PROJECT_ROOT/progress.txt"
  STATE_DIR="$PROJECT_ROOT/.midiarranger"
  ARCHIVE_DIR="$STATE_DIR/archive"
  BRIEF_HASH_FILE="$STATE_DIR/$BRIEF_HASH_FILE_NAME"
  AGENT_OUTPUT_FILE="$STATE_DIR/last-agent-output.txt"
}

sha256_file() {
  if command -v python3 >/dev/null 2>&1; then
    if PYTHONPATH="$INSTALL_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 - "$1" 2>/dev/null <<'PY'
import sys
from tools.brief_ref import brief_sha256

print(brief_sha256(sys.argv[1]))
PY
    then
      return 0
    fi
  fi

  shasum -a 256 "$1" | awk '{ print $1 }'
}

sanitize_slug() {
  local value="$1"

  printf '%s\n' "$value" \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^-//; s/-$//' \
    | cut -c 1-48
}

brief_archive_slug() {
  local brief_hash="$1"
  local input_midi
  local base
  local slug

  input_midi="$(
    sed -n 's/.*"input_midi"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$BRIEF_FILE" \
      | head -n 1
  )"

  if [[ -n "$input_midi" ]]; then
    base="$(basename "$input_midi")"
    base="${base%.*}"
    slug="$(sanitize_slug "$base")"
  fi

  if [[ -z "${slug:-}" ]]; then
    slug="brief-${brief_hash:0:12}"
  fi

  printf '%s\n' "$slug"
}

unique_archive_path() {
  local slug="$1"
  local stamp
  local candidate
  local suffix

  stamp="$(date '+%Y%m%d-%H%M%S')"
  candidate="$ARCHIVE_DIR/$stamp-$slug"
  suffix=2

  while [[ -e "$candidate" ]]; do
    candidate="$ARCHIVE_DIR/$stamp-$slug-$suffix"
    suffix=$((suffix + 1))
  done

  printf '%s\n' "$candidate"
}

archive_previous_run_state() {
  local brief_hash="$1"
  local slug
  local destination
  local moved_any=0

  slug="$(brief_archive_slug "$brief_hash")"
  destination="$(unique_archive_path "$slug")"
  mkdir -p "$destination" \
    || die_unavailable "could not create archive directory: $destination"

  if [[ -e "$PLAN_FILE" ]]; then
    mv "$PLAN_FILE" "$destination/" \
      || die_unavailable "could not archive arrangement plan: $PLAN_FILE"
    moved_any=1
  fi

  if [[ -e "$PROGRESS_FILE" ]]; then
    mv "$PROGRESS_FILE" "$destination/" \
      || die_unavailable "could not archive progress log: $PROGRESS_FILE"
    moved_any=1
  fi

  if [[ "$moved_any" -eq 0 ]]; then
    rmdir "$destination" \
      || die_unavailable "could not remove empty archive directory: $destination"
  fi
}

sync_brief_hash_and_archive_if_needed() {
  local current_hash
  local previous_hash

  current_hash="$(sha256_file "$BRIEF_FILE")" \
    || die_unavailable "could not hash arrangement brief: $BRIEF_FILE"

  previous_hash=""
  if [[ -f "$BRIEF_HASH_FILE" ]]; then
    previous_hash="$(sed -n '1p' "$BRIEF_HASH_FILE")"
  fi

  if [[ -n "$previous_hash" && "$previous_hash" != "$current_hash" ]]; then
    mkdir -p "$ARCHIVE_DIR" \
      || die_unavailable "could not create archive directory: $ARCHIVE_DIR"
    archive_previous_run_state "$current_hash"
  fi

  printf '%s\n' "$current_hash" > "$BRIEF_HASH_FILE" \
    || die_unavailable "could not record arrangement brief hash: $BRIEF_HASH_FILE"
  RUN_BRIEF_HASH="$current_hash"
}

ensure_run_state() {
  if [[ ! -f "$BRIEF_FILE" ]]; then
    die_noinput "arrangement-brief.json not found in '$PROJECT_ROOT'. Run 'midi-arranger brief <input.mid>' first."
  fi

  mkdir -p "$STATE_DIR" \
    || die_unavailable "could not create state directory: $STATE_DIR"

  sync_brief_hash_and_archive_if_needed

  if [[ ! -e "$PROGRESS_FILE" ]]; then
    {
      printf '# midi-arranger progress\n'
      printf '%s\n' '---'
    } > "$PROGRESS_FILE" \
      || die_unavailable "could not create progress log: $PROGRESS_FILE"
  fi

  if [[ ! -f "$PROGRESS_FILE" ]]; then
    die_unavailable "progress path exists but is not a file: $PROGRESS_FILE"
  fi

  {
    printf '## run started %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
    printf -- '- tool=%s\n' "$TOOL"
    printf -- '- max_iterations=%s\n' "$MAX_ITERATIONS"
    printf '%s\n' '---'
  } >> "$PROGRESS_FILE" \
    || die_unavailable "could not append to progress log: $PROGRESS_FILE"
}

parse_positive_integer() {
  local value="$1"
  local label="$2"

  if [[ ! "$value" =~ ^[1-9][0-9]*$ ]]; then
    die_usage "$label must be a positive integer."
  fi
}

COMMAND=""
TOOL="codex"
MODEL=""
EFFORT=""
CWD=""
FIXTURE=""
KEEP=0
MAX_ITERATIONS=""
CURRENT_ITERATION=""
RUN_BRIEF_HASH=""
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      if [[ -z "$COMMAND" ]]; then
        print_usage
        exit 0
      fi
      die_usage "--help is only supported as a top-level command."
      ;;
    --list-models)
      if [[ -n "$COMMAND" ]]; then
        die_usage "--list-models must be used as a top-level command."
      fi
      COMMAND="list-models"
      shift
      ;;
    brief|run|tool|doctor|test-drive)
      if [[ -n "$COMMAND" ]]; then
        die_usage "Unexpected argument '$1' after command '$COMMAND'."
      fi
      COMMAND="$1"
      shift
      ;;
    --tool)
      require_value "$1" "${2:-}"
      TOOL="$2"
      validate_tool "$TOOL"
      shift 2
      ;;
    --tool=*)
      TOOL="${1#*=}"
      require_value "--tool" "$TOOL"
      validate_tool "$TOOL"
      shift
      ;;
    --model)
      require_value "$1" "${2:-}"
      MODEL="$2"
      shift 2
      ;;
    --model=*)
      MODEL="${1#*=}"
      require_value "--model" "$MODEL"
      shift
      ;;
    --effort)
      require_value "$1" "${2:-}"
      EFFORT="$2"
      EFFORT_EXPLICIT=1
      shift 2
      ;;
    --effort=*)
      EFFORT="${1#*=}"
      require_value "--effort" "$EFFORT"
      EFFORT_EXPLICIT=1
      shift
      ;;
    --cwd)
      require_value "$1" "${2:-}"
      CWD="$2"
      shift 2
      ;;
    --cwd=*)
      CWD="${1#*=}"
      require_value "--cwd" "$CWD"
      shift
      ;;
    --fixture)
      require_value "$1" "${2:-}"
      FIXTURE="$2"
      shift 2
      ;;
    --fixture=*)
      FIXTURE="${1#*=}"
      require_value "--fixture" "$FIXTURE"
      shift
      ;;
    --keep)
      KEEP=1
      shift
      ;;
    --*)
      die_usage "Unknown argument '$1'."
      ;;
    *)
      POSITIONAL+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$COMMAND" ]]; then
  die_usage "Missing command. Run 'midi-arranger --help' for usage."
fi

PROJECT_ROOT="${CWD:-}"
if [[ -n "$PROJECT_ROOT" ]]; then
  PROJECT_ROOT="$(cd "$PROJECT_ROOT" && pwd -P)" || die_usage "Cannot access --cwd directory '$CWD'."
else
  PROJECT_ROOT="$(resolve_project_root "$PWD")"
fi
initialize_project_paths

case "$COMMAND" in
  brief)
    if [[ "${#POSITIONAL[@]}" -ne 1 ]]; then
      die_usage "brief requires exactly one MIDI file argument."
    fi
    invoke_agent_once "brief" "input_midi=${POSITIONAL[0]}"
    ;;
  run)
    if [[ "${#POSITIONAL[@]}" -gt 1 ]]; then
      die_usage "run accepts at most one max_iterations argument."
    fi
    if [[ "${#POSITIONAL[@]}" -eq 1 ]]; then
      parse_positive_integer "${POSITIONAL[0]}" "max_iterations"
      MAX_ITERATIONS="${POSITIONAL[0]}"
    else
      MAX_ITERATIONS="10"
    fi
    validate_effort_support "$TOOL"
    ensure_run_state
    run_agent_loop
    ;;
  tool)
    if [[ "${#POSITIONAL[@]}" -lt 1 ]]; then
      die_usage "tool requires a tool name."
    fi
    die_unavailable "tool parsed successfully for project '$PROJECT_ROOT', but deterministic tool dispatch is not implemented yet."
    ;;
  doctor)
    if [[ "${#POSITIONAL[@]}" -ne 0 ]]; then
      die_usage "doctor does not accept positional arguments."
    fi
    require_python3 "doctor"
    provider_status="not_queried"
    provider_binary=""
    if binary="$(tool_binary_path "$TOOL")"; then
      provider_status="found"
      provider_binary="$binary"
    else
      provider_status="absent"
    fi
    doctor_args=(--tool "$TOOL" --provider-status "$provider_status" --project-root "$PROJECT_ROOT")
    [[ -n "$provider_binary" ]] && doctor_args+=(--provider-binary "$provider_binary")
    [[ -n "$MODEL" ]] && doctor_args+=(--model "$MODEL")
    run_python_module tools.doctor "${doctor_args[@]}"
    ;;
  test-drive)
    if [[ "${#POSITIONAL[@]}" -ne 0 ]]; then
      die_usage "test-drive does not accept positional arguments."
    fi
    require_python3 "test-drive"
    test_drive_args=()
    [[ -n "$FIXTURE" ]] && test_drive_args+=(--fixture "$FIXTURE")
    [[ "$KEEP" -eq 1 ]] && test_drive_args+=(--keep)
    run_python_module tools.test_drive "${test_drive_args[@]}"
    ;;
  list-models)
    if [[ "${#POSITIONAL[@]}" -ne 0 ]]; then
      die_usage "--list-models does not accept positional arguments."
    fi
    print_model_discovery
    ;;
  *)
    die_usage "Unknown command '$COMMAND'."
    ;;
esac
