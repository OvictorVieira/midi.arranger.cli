#!/usr/bin/env bash
set -euo pipefail

binary_name="$(basename "$0")"
stdin_payload="$(cat)"
prompt_payload="$stdin_payload"
args=("$@")
invocation="$(( $(grep -c '^BIN<<END$' "$MOCK_LOG" 2>/dev/null || true) + 1 ))"

for ((index = 0; index < ${#args[@]}; index += 1)); do
  if [[ "${args[$index]}" == "--prompt" && "$((index + 1))" -lt "${#args[@]}" ]]; then
    prompt_payload="${args[$((index + 1))]}"
  fi
done

{
  printf 'BIN<<END\n%s\nEND\n' "$binary_name"
  index=0
  for arg in "$@"; do
    printf 'ARG_%s<<END\n%s\nEND\n' "$index" "$arg"
    index=$((index + 1))
  done
  printf 'STDIN<<END\n%s\nEND\n' "$stdin_payload"
  printf 'PROMPT<<END\n%s\nEND\n' "$prompt_payload"
} >> "$MOCK_LOG"

if [[ "${MOCK_REWRITE_BRIEF_ON:-}" == "$invocation" ]]; then
  project_root="$(printf '%s\n' "$prompt_payload" | sed -n 's/^project_root=//p' | head -n 1)"
  rewrite_content="${MOCK_BRIEF_REWRITE_CONTENT:-{\"input_midi\":\"changed.mid\"}}"
  if [[ -n "$project_root" ]]; then
    printf '%s\n' "$rewrite_content" > "$project_root/arrangement-brief.json"
  fi
fi

printf 'mock output from %s\n' "$binary_name"
if [[ "${MOCK_COMPLETE_ON:-}" == "$invocation" ]]; then
  printf '<promise>COMPLETE</promise>\n'
fi
